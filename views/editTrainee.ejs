<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Trainee</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
<div class="container mt-4">
  <h1>Edit Trainee</h1>

  <form id="editForm" action="/training/edit/<%= trainee._id %>" method="POST">
    <!-- Full Name -->
    <label>Full Name</label>
    <input type="text" name="fullname" class="form-control mb-2" value="<%= trainee.fullname %>" required>

    <!-- Phone Number -->
    <label>Phone Number</label>
    <input type="text" name="phoneNumber" class="form-control mb-2" value="<%= trainee.phoneNumber %>" required>

    <!-- Case Type -->
    <label>Case Type</label>
    <select name="caseType" id="caseType" class="form-control mb-2" required>
      <option value="">Select Case Type</option>
      <option value="completed" <%= trainee.caseType === 'completed' ? 'selected' : '' %>>Completed</option>
      <option value="delay" <%= trainee.caseType === 'delay' ? 'selected' : '' %>>Delay</option>
      <option value="exception" <%= trainee.caseType === 'exception' ? 'selected' : '' %>>Exception</option>
      <option value="exempted" <%= trainee.caseType === 'exempted' ? 'selected' : '' %>>Exempted</option>
    </select>

    <!-- Reason -->
    <select name="reason" id="reason" class="form-control mb-2" style="display:none;">
      <option value="">Select Reason</option>
    </select>

    <!-- Batch No -->
    <div id="batchNoDiv" class="mb-2" style="display:none;">
      <label>Batch No</label>
      <input type="text" name="batchNo" class="form-control" value="<%= trainee.batchNo || '' %>">
    </div>

    <!-- Force No -->
    <div id="forceNoDiv" class="mb-2" style="display:none;">
      <label>Force No</label>
      <input type="text" name="forceNo" class="form-control" value="<%= trainee.forceNo || '' %>">
    </div>

    <!-- Batch Years -->
    <div id="batchYearsDiv" class="mb-2">
      <label>Batch Start Year</label>
      <input type="number" name="batchStartYear" id="batchStartYear" class="form-control" value="<%= trainee.batchStartYear || '' %>">
      <label class="mt-2">Batch End Year</label>
      <input type="number" name="batchEndYear" id="batchEndYear" class="form-control" value="<%= trainee.batchEndYear || '' %>">
    </div>

    <!-- Active Checkbox -->
    <div class="form-check mb-2">
      <input type="checkbox" name="isActive" value="true" class="form-check-input" id="isActive" <%= trainee.isActive ? 'checked' : '' %>>
      <label class="form-check-label" for="isActive">Active</label>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Update</button>
  </form>
</div>

<script>
const caseType = document.getElementById('caseType');
const reason = document.getElementById('reason');
const batchNoDiv = document.getElementById('batchNoDiv');
const forceNoDiv = document.getElementById('forceNoDiv');
const batchStartYear = document.getElementById('batchStartYear');
const batchEndYear = document.getElementById('batchEndYear');
const isActive = document.getElementById('isActive');

const reasonOptions = {
  delay: [
    'Considered as the only son',
    'Completing studies',
    'Only child of mother',
    'Only child of father',
    'Medical deferment',
    'Accompanying for study abroad',
    'Sole supporter of mother',
    'Sole supporter of disabled siblings',
    'Other'
  ],
  exception: ['Active duty soldier', 'Completed basic training'],
  exempted: ['Medically unfit']
};

// Show/hide Reason, Batch, Force based on Case Type
function applyCaseType(type) {
  let selectedReason = reason.value;

  reason.style.display = 'none';
  reason.innerHTML = '<option value="">Select Reason</option>';
  batchNoDiv.style.display = 'none';
  forceNoDiv.style.display = 'none';

  if(type === 'delay') {
    reason.style.display = 'block';
    batchNoDiv.style.display = 'block';
    reasonOptions.delay.forEach(r => reason.innerHTML += `<option value="${r}">${r}</option>`);
  } else if(type === 'completed') {
    batchNoDiv.style.display = 'block';
  } else if(type === 'exception') {
    reason.style.display = 'block';
    forceNoDiv.style.display = 'block';
    reasonOptions.exception.forEach(r => reason.innerHTML += `<option value="${r}">${r}</option>`);
  } else if(type === 'exempted') {
    reason.style.display = 'block';
    reasonOptions.exempted.forEach(r => reason.innerHTML += `<option value="${r}">${r}</option>`);
  }

  // Restore selected reason
  if("<%= trainee.reason || '' %>") reason.value = "<%= trainee.reason || '' %>";

  updateActiveCheckbox();
}

// Enable/disable Active + remove Case Type required if checked
function updateActiveCheckbox() {
  const start = Number(batchStartYear.value);
  const end = Number(batchEndYear.value);
  const currentYear = new Date().getFullYear();

  if(isActive.checked) {
    caseType.disabled = true;
    caseType.removeAttribute('required');
  } else {
    caseType.disabled = false;
    caseType.setAttribute('required', 'required');
  }

  // Auto-enable Active if current year matches start/end
  if(!isActive.checked && (start === currentYear || end === currentYear)) {
    isActive.disabled = false;
  }
}

// Event listeners
caseType.addEventListener('change', () => applyCaseType(caseType.value));
batchStartYear.addEventListener('input', updateActiveCheckbox);
batchEndYear.addEventListener('input', updateActiveCheckbox);
isActive.addEventListener('change', updateActiveCheckbox);

// Initialize
applyCaseType(caseType.value);
updateActiveCheckbox();
</script>

</body>
</html>
