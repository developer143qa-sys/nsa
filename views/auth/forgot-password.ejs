<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <title>Forgot Password</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #e0e7ff 0%, #f8fafc 100%);
      color: #0f172a;
    }
    body[dir="rtl"] { text-align: right; }
    .auth-shell {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .auth-card {
      width: 100%;
      max-width: 460px;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid #dbeafe;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(30, 41, 59, 0.12);
      padding: 24px;
    }
    .brand-logo {
      width: 74px;
      height: 74px;
      object-fit: contain;
      border-radius: 10px;
      border: 1px solid #dbeafe;
      background: #fff;
      padding: 4px;
      margin-bottom: 8px;
    }
    .brand-title {
      font-size: 22px;
      font-weight: 800;
      color: #1e3a8a;
      margin-bottom: 2px;
    }
    .brand-subtitle {
      color: #475569;
      font-size: 13px;
      margin-bottom: 18px;
    }
    .form-label { font-weight: 600; color: #334155; }
    .form-control {
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      padding: 10px 12px;
    }
    .auth-link {
      text-decoration: none;
      font-weight: 700;
      color: #1d4ed8;
    }
  </style>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="text-center">
        <img src="/images/download.jfif" alt="National Service Academy Logo" class="brand-logo">
        <div class="brand-title">National Service Academy</div>
        <div class="brand-subtitle">Recover your account password</div>
        <h3 class="mb-3">Forgot Password</h3>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form action="/auth/forgot-password" method="POST">
        <div class="mb-3">
          <label class="form-label"><%= __('email') %></label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <button class="btn btn-primary w-100" type="submit">Generate Reset Link</button>
      </form>

      <p class="mt-3 text-center">
        <a href="/auth/login" class="auth-link">Back to Login</a>
      </p>
    </div>
  </div>
</body>
</html>
