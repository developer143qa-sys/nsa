<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <title><%= __('login') %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #e0e7ff 0%, #f8fafc 100%);
      color: #0f172a;
    }
    body[dir="rtl"] {
      text-align: right;
    }
    .auth-shell {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .auth-card {
      width: 100%;
      max-width: 440px;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid #dbeafe;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(30, 41, 59, 0.12);
      padding: 24px;
    }
    .brand-title {
      font-size: 22px;
      font-weight: 800;
      color: #1e3a8a;
      margin-bottom: 2px;
    }
    .brand-logo {
      width: 74px;
      height: 74px;
      object-fit: contain;
      border-radius: 10px;
      border: 1px solid #dbeafe;
      background: #fff;
      padding: 4px;
      margin-bottom: 8px;
    }
    .brand-subtitle {
      color: #475569;
      font-size: 13px;
      margin-bottom: 18px;
    }
    .form-label {
      font-weight: 600;
      color: #334155;
    }
    .form-control {
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      padding: 10px 12px;
    }
    .form-control:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.15);
    }
    .password-wrap {
      position: relative;
    }
    .toggle-password {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      color: #475569;
      font-weight: 600;
      font-size: 12px;
    }
    body[dir="rtl"] .toggle-password {
      right: auto;
      left: 10px;
    }
    a.lang-switch,
    .auth-link {
      text-decoration: none;
      font-weight: 700;
      color: #1d4ed8;
    }
    a.lang-switch:hover,
    .auth-link:hover {
      color: #1e40af;
    }
  </style>
</head>
<body>
  <div class="auth-shell">
  <div class="auth-card">
    <div class="text-center">
      <img src="/images/download.jfif" alt="National Service Academy Logo" class="brand-logo">
      <div class="brand-title">National Service Academy</div>
      <div class="brand-subtitle">Secure trainee management access</div>
      <h3 class="mb-3"><%= __('login') %></h3>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/auth/login" method="POST">
      
      <!-- Email -->
      <div class="mb-3">
        <label class="form-label"><%= __('email') %></label>
        <input type="email" name="email" class="form-control" required>
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label class="form-label"><%= __('password') %></label>
        <div class="password-wrap">
          <input id="loginPassword" type="password" name="password" class="form-control" required>
          <button type="button" class="toggle-password" id="toggleLoginPassword">Show</button>
        </div>
      </div>

      <button class="btn btn-primary w-100">
        <%= __('login') %>
      </button>

    </form>

    <p class="mt-2 mb-0 text-end">
      <a href="/auth/forgot-password" class="auth-link">Forgot password?</a>
    </p>
    <p class="mt-3 text-center">
      <%= __('noAccount') %> 
      <a href="/auth/register" class="auth-link"><%= __('register') %></a>
    </p>

    <hr>

    <!-- ✅ Language Switch (WORKING + SAFE) -->
    <div class="text-center">
      <a href="/lang/en?redirect=<%= encodeURIComponent(currentUrl || '/') %>" class="lang-switch">
        English
      </a> 
      | 
      <a href="/lang/ar?redirect=<%= encodeURIComponent(currentUrl || '/') %>" class="lang-switch">
        العربية
      </a>
    </div>

  </div>
  </div>

  <script>
    const loginPassword = document.getElementById('loginPassword');
    const toggleLoginPassword = document.getElementById('toggleLoginPassword');
    toggleLoginPassword.addEventListener('click', () => {
      const isPassword = loginPassword.type === 'password';
      loginPassword.type = isPassword ? 'text' : 'password';
      toggleLoginPassword.textContent = isPassword ? 'Hide' : 'Show';
    });
  </script>

</body>
</html>