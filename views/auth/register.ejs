<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <title><%= __('register') %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, #e0e7ff 0%, #f8fafc 100%);
      color: #0f172a;
    }
    body[dir="rtl"] {
      text-align: right;
    }
    .auth-shell {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .auth-card {
      width: 100%;
      max-width: 460px;
      background: rgba(255, 255, 255, 0.95);
      border: 1px solid #dbeafe;
      border-radius: 16px;
      box-shadow: 0 12px 30px rgba(30, 41, 59, 0.12);
      padding: 24px;
    }
    .brand-title {
      font-size: 22px;
      font-weight: 800;
      color: #1e3a8a;
      margin-bottom: 2px;
    }
    .brand-logo {
      width: 74px;
      height: 74px;
      object-fit: contain;
      border-radius: 10px;
      border: 1px solid #dbeafe;
      background: #fff;
      padding: 4px;
      margin-bottom: 8px;
    }
    .brand-subtitle {
      color: #475569;
      font-size: 13px;
      margin-bottom: 18px;
    }
    .form-label {
      font-weight: 600;
      color: #334155;
    }
    .form-control {
      border-radius: 10px;
      border: 1px solid #cbd5e1;
      padding: 10px 12px;
    }
    .form-control:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 0.2rem rgba(99, 102, 241, 0.15);
    }
    .password-wrap {
      position: relative;
    }
    .toggle-password {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      color: #475569;
      font-weight: 600;
      font-size: 12px;
    }
    body[dir="rtl"] .toggle-password {
      right: auto;
      left: 10px;
    }
    .password-hint {
      font-size: 12px;
      color: #64748b;
      margin-top: 4px;
    }
    a.lang-switch,
    .auth-link {
      text-decoration: none;
      font-weight: 700;
      color: #1d4ed8;
    }
    a.lang-switch:hover,
    .auth-link:hover {
      color: #1e40af;
    }
  </style>
</head>
<body>
  <div class="auth-shell">
  <div class="auth-card">
    <div class="text-center">
      <img src="/images/download.jfif" alt="National Service Academy Logo" class="brand-logo">
      <div class="brand-title">National Service Academy</div>
      <div class="brand-subtitle">Create your secure account</div>
      <h3 class="mb-3"><%= __('register') %></h3>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/auth/register" method="POST">
      <!-- Full Name -->
      <div class="mb-3">
        <label for="username" class="form-label"><%= __('fullName') %></label>
        <input type="text" name="username" class="form-control" required>
      </div>

      <!-- Email -->
      <div class="mb-3">
        <label for="email" class="form-label"><%= __('email') %></label>
        <input type="email" name="email" class="form-control" required>
      </div>

      <!-- Password -->
      <div class="mb-3">
        <label for="password" class="form-label"><%= __('password') %></label>
        <div class="password-wrap">
          <input id="registerPassword" type="password" name="password" class="form-control" required>
          <button type="button" class="toggle-password" id="toggleRegisterPassword">Show</button>
        </div>
        <div class="password-hint">Use at least 8 characters for a stronger password.</div>
      </div>

      <div class="mb-3">
        <label for="confirmPassword" class="form-label">Confirm Password</label>
        <div class="password-wrap">
          <input id="confirmPassword" type="password" name="confirmPassword" class="form-control" required>
          <button type="button" class="toggle-password" id="toggleConfirmPassword">Show</button>
        </div>
      </div>

      <button class="btn btn-success w-100"><%= __('register') %></button>
    </form>

    <p class="mt-3 text-center">
      <%= __('alreadyAccount') %> <a href="/auth/login" class="auth-link"><%= __('login') %></a>
    </p>

    <hr>

    <!-- Language Switch -->
    <div class="text-center">
      <a href="/lang/en?redirect=<%= encodeURIComponent(currentUrl) %>" class="lang-switch">English</a> |
      <a href="/lang/ar?redirect=<%= encodeURIComponent(currentUrl) %>" class="lang-switch">العربية</a>
    </div>
  </div>
  </div>

  <script>
    const toggleField = (buttonId, inputId) => {
      const button = document.getElementById(buttonId);
      const input = document.getElementById(inputId);
      button.addEventListener('click', () => {
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        button.textContent = isPassword ? 'Hide' : 'Show';
      });
    };

    toggleField('toggleRegisterPassword', 'registerPassword');
    toggleField('toggleConfirmPassword', 'confirmPassword');
  </script>
</body>
</html>
