<!-- Main Layout Container -->
<div class="d-flex flex-row-reverse" style="min-height: 100vh; background-color: #f8f9fa;">

  <!-- Right Sidebar -->
  <!-- <aside class="bg-dark text-white p-3" style="width: 250px;">
    <h5 class="text-center mb-4 fw-bold">📋 Menu</h5>
    <ul class="nav flex-column">
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/api/users/dashboard">🏠 Dashboard</a>
      </li>
      <li class="nav-item mb-2">
