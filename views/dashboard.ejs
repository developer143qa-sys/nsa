<%- include('partials/header') %>

<!-- Main Layout Container -->
<div class="d-flex" style="min-height: 100vh; background-color: #f8f9fa;">

  <!-- Sidebar auto-included from layout -->

  <!-- Main Content -->
  <main class="main-content flex-grow-1 p-4">
    <h2 class="mb-4 text-primary fw-bold">🚀 Welcome to Your Dashboard</h2>

    <div class="row g-4">

      <!-- Total Users Card -->
      <div class="col-md-4">
        <div class="card shadow-lg border-0 rounded-4 text-white"
             style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%); transition: transform 0.3s ease;">
          <div class="card-body d-flex align-items-center">
            <i class="bi bi-people-fill display-4 me-3"></i>
            <div>
              <h6 class="mb-1 text-uppercase fw-bold" style="font-size: 0.9rem;">Total Users</h6>
              <h3 class="mb-0 fw-semibold"><%= totalUsers %></h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Messages Card -->
      <div class="col-md-4">
        <div class="card shadow-lg border-0 rounded-4 text-white"
             style="background: linear-gradient(135deg, #ff5858 0%, #f09819 100%); transition: transform 0.3s ease;">
          <div class="card-body d-flex align-items-center">
            <i class="bi bi-envelope-fill display-4 me-3"></i>
            <div>
              <h6 class="mb-1 text-uppercase fw-bold" style="font-size: 0.9rem;">Messages</h6>
              <h3 class="mb-0 fw-semibold"><%= totalMessages %></h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Tasks Card -->
      <div class="col-md-4">
        <div class="card shadow-lg border-0 rounded-4 text-white"
             style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); transition: transform 0.3s ease;">
          <div class="card-body d-flex align-items-center">
            <i class="bi bi-list-task display-4 me-3"></i>
            <div>
              <h6 class="mb-1 text-uppercase fw-bold" style="font-size: 0.9rem;">Tasks</h6>
              <h3 class="mb-0 fw-semibold"><%= totalTasks %></h3>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<!-- Card Hover Effect -->
<style>
  .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 20px rgba(0, 0, 0, 0.25);
  }
</style>

<%- include('partials/footer') %>
