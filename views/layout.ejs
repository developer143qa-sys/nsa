<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Training App</title>
    
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body { padding-top: 60px; }
        header { margin-bottom: 30px; }
        footer { margin-top: 50px; text-align: center; color: #777; }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">Training Records</a>
        </div>
    </nav>

    <!-- Main container -->
    <div class="container">
        <%- body %>  <!-- This renders page content -->
    </div>

    <footer>
        <p>&copy; 2025 Training App. All rights reserved.</p>
    </footer>

    <!-- Bootstrap 5 JS CDN (Optional, for components like modals) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
