<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <style>
    .sidebar { width: 250px; min-height: 100vh; background-color: #1f2937; color: white; }
    .sidebar a { color: white; text-decoration: none; }
    .sidebar a:hover { background-color: #374151; }
    .card { box-shadow: 0 4px 6px rgba(0,0,0,0.1); border-radius: 10px; text-align: center; }
    .card-title { font-weight: bold; }

    /* Print Styles */
    @media print {
      .no-print { display: none !important; }
      body::before {
        content: "Admin Dashboard";
        display: block;
        text-align: right;
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 10px;
      }
      body::after {
        content: "http://localhost";
        display: block;
        text-align: left;
        font-size: 12px;
        margin-bottom: 10px;
      }
    }
  </style>
</head>
<body>
<div class="dashboard-container d-flex">

  <!-- Sidebar -->
  <div class="sidebar p-3">
    <h3>Admin Panel</h3>
    <nav class="mt-4">
      <ul class="nav flex-column">
        <li class="nav-item mb-2">
          <a class="nav-link btn btn-outline-light w-100 mb-2" href="/training/admin">Dashboard</a>
        </li>
        <li class="nav-item mb-2">
          <a class="nav-link btn btn-outline-light w-100" href="/training/add">Add Trainee</a>
        </li>
        <li class="nav-item">
          <a class="nav-link btn btn-danger w-100" href="/auth/logout">Logout</a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Main Content -->
  <div class="main-content flex-grow-1 p-4">
    <h1>Trainee Dashboard</h1>

    <!-- Cards Section -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
          <div class="card-body">
            <h5 class="card-title">Completed</h5>
            <p class="card-text fs-3"><%= completedCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
          <div class="card-body">
            <h5 class="card-title">Delay</h5>
            <p class="card-text fs-3"><%= delayCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
          <div class="card-body">
            <h5 class="card-title">Exception</h5>
            <p class="card-text fs-3"><%= exceptionCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
          <div class="card-body">
            <h5 class="card-title">Exempted</h5>
            <p class="card-text fs-3"><%= exemptedCount %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Total Trainees -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
          <div class="card-body">
            <h5 class="card-title">Total Trainees</h5>
            <p class="card-text fs-3"><%= totalTrainees %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter + Buttons -->
    <form id="filterForm" class="row g-3 align-items-center mb-3" method="GET" action="/training/admin">
      <div class="col-md-4">
        <label class="form-label">Search (QID / Name / Phone / CaseType)</label>
        <input type="text" name="search" class="form-control" value="<%= search || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="<%= from || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="<%= to || '' %>">
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="button" onclick="window.print()" class="btn btn-secondary w-100">Print</button>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="exportBtn" class="btn btn-success w-100">Export to Excel</button>
      </div>
    </form>

    <!-- Trainee Table -->
    <div class="table-section">
      <table class="table table-bordered table-striped" id="traineeTable">
        <thead class="table-dark">
          <tr>
            <th>QID</th>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Case Type</th>
            <th>Batch No</th> <!-- New column -->
            <th>Batch Start</th>
            <th>Batch End</th>
            <th class="no-print">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% trainees.forEach(t => { %>
            <tr>
              <td class="qid"><%= t.qid %></td>
              <td class="fullname"><%= t.fullname %></td>
              <td class="phone"><%= t.phoneNumber %></td>
              <td class="caseType"><%= t.caseType %></td>
              <td class="batchNo"><%= t.batchNo || '' %></td>
              <td class="batchStart"><%= t.batchStartDate ? t.batchStartDate.toISOString().slice(0,10) : '' %></td>
              <td class="batchEnd"><%= t.batchEndDate ? t.batchEndDate.toISOString().slice(0,10) : '' %></td>
              <td class="no-print">
                <a href="/training/edit/<%= t._id %>" class="btn btn-warning btn-sm">Edit</a>
                <form action="/training/delete/<%= t._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- SheetJS for Excel Export -->
<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
<script>
  document.getElementById('exportBtn').addEventListener('click', function () {
    var table = document.getElementById('traineeTable');
    var wb = XLSX.utils.table_to_book(table, {sheet:"Trainees"});
    XLSX.writeFile(wb, 'trainees.xlsx');
  });
</script>

</body>
</html>
