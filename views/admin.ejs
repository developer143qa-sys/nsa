<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard / لوحة التحكم</title>

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

  <style>
    body {
      font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #eef2ff 0%, #f8fafc 100%);
      color: #111827;
    }
    .sidebar {
      width: 310px;
      min-height: 100vh;
      background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
      color: white;
      padding: 24px 18px;
      box-shadow: 4px 0 12px rgba(15, 23, 42, 0.25);
    }
    .sidebar a {
      color: white;
      text-decoration: none;
      border-radius: 8px;
      transition: all 0.2s ease;
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .sidebar a:hover {
      background-color: #334155;
      transform: translateX(2px);
    }
    .sidebar .btn-light {
      color: #000 !important;
    }
    .main-panel {
      background: rgba(255, 255, 255, 0.92);
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      margin: 20px;
    }
    .card {
      border: none;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      border-radius: 14px;
      text-align: center;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
    }
    .card-title { font-weight: 700; letter-spacing: 0.2px; }
    .form-control, .btn, .table {
      border-radius: 10px;
    }
    .btn {
      font-weight: 600;
      letter-spacing: 0.2px;
    }
    .academy-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      background: linear-gradient(90deg, #e0e7ff 0%, #eef2ff 100%);
      border: 1px solid #c7d2fe;
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 14px;
    }
    .academy-brand img {
      width: 72px;
      height: 72px;
      object-fit: contain;
      border-radius: 8px;
      background: #fff;
      border: 1px solid #dbeafe;
      padding: 4px;
    }
    .academy-brand h2 {
      margin: 0;
      font-size: 18px;
      font-weight: 800;
      color: #1e3a8a;
    }
    .academy-brand p {
      margin: 0;
      color: #334155;
      font-size: 13px;
    }
    .table-section {
      background: #fff;
      border-radius: 14px;
      padding: 12px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }
    #traineeTable {
      margin-bottom: 0;
      overflow: hidden;
      border-radius: 10px;
    }
    #traineeTable thead th {
      vertical-align: middle;
      white-space: nowrap;
      border-bottom: 0;
    }
    #traineeTable tbody tr:hover {
      background-color: #f8fafc;
      transition: background-color 0.2s ease;
    }
    .status-badge, .case-badge {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2px;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .badge-active { background: #dcfce7; color: #166534; }
    .badge-upcoming { background: #fef9c3; color: #854d0e; }
    .badge-completed { background: #dbeafe; color: #1d4ed8; }
    .badge-delay { background: #fee2e2; color: #991b1b; }
    .badge-exception { background: #fce7f3; color: #9d174d; }
    .badge-exempted { background: #ede9fe; color: #5b21b6; }
    .badge-pending { background: #e5e7eb; color: #374151; }
    .badge-default { background: #e2e8f0; color: #334155; }
    body.rtl { direction: rtl; text-align: right; }
    @media print {
      body * { visibility: hidden; }
      #traineeTable, #traineeTable * { visibility: visible; }
      #traineeTable { position: absolute; top: 0; left: 0; width: 100%; }
      #traineeTable th, #traineeTable td { border: 1px solid #000 !important; padding: 5px; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="<%= locale === 'ar' ? 'rtl' : '' %>">

<div class="d-flex">

  <!-- Sidebar -->
  <div class="sidebar no-print">
    <h3 class="text-center">Admin Panel / لوحة التحكم</h3>
    <nav class="mt-4">
      <ul class="nav flex-column">
        <li class="nav-item mb-2">
          <a class="nav-link btn btn-outline-light w-100 mb-2" href="/training/admin">Dashboard / لوحة المعلومات</a>
        </li>
        <li class="nav-item mb-2">
          <a class="nav-link btn btn-outline-light w-100" href="/training/add">Add Trainee / إضافة متدرب</a>
        </li>
        <li class="nav-item">
          <a class="nav-link btn btn-danger w-100" href="/auth/logout">Logout / تسجيل الخروج</a>
        </li>
      </ul>
    </nav>
    <div class="mt-4">
      <a href="/lang/en" class="btn btn-light btn-sm w-100 mb-1">English</a>
      <a href="/lang/ar" class="btn btn-light btn-sm w-100">العربية</a>
    </div>
  </div>
  <!-- End Sidebar -->

  <!-- Main Content -->
  <div class="flex-grow-1 p-4 main-panel">
    <div class="academy-brand">
      <img src="/images/download.jfif" alt="National Service Academy Logo">
      <div>
        <h2>National Service Academy</h2>
        <p>Admin Management Dashboard</p>
      </div>
    </div>

    <h1 class="mb-4">Trainee Dashboard / لوحة المتدربين</h1>

    <!-- Status Cards -->
    <div class="row mb-4">
      <div class="col-md-2">
        <div class="card text-white bg-success mb-3">
          <div class="card-body">
            <h5 class="card-title">Completed / مكتمل</h5>
            <p class="card-text fs-3"><%= completedCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card text-white bg-warning mb-3">
          <div class="card-body">
            <h5 class="card-title">Upcoming / قادم</h5>
            <p class="card-text fs-3"><%= upcomingCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card text-white bg-primary mb-3">
          <div class="card-body">
            <h5 class="card-title">Active / نشط</h5>
            <p class="card-text fs-3"><%= activeCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card text-white bg-danger mb-3">
          <div class="card-body">
            <h5 class="card-title">Exception / استثناء</h5>
            <p class="card-text fs-3"><%= exceptionCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card text-white bg-info mb-3">
          <div class="card-body">
            <h5 class="card-title">Exempted / معفى</h5>
            <p class="card-text fs-3"><%= exemptedCount %></p>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="card text-white bg-dark mb-3">
          <div class="card-body">
            <h5 class="card-title">Total / الإجمالي</h5>
            <p class="card-text fs-3"><%= totalTrainees %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Form -->
    <form class="row g-3 align-items-end mb-3 no-print" method="GET" action="/training/admin">
      <div class="col-md-4">
        <label class="form-label">Search / البحث</label>
        <input type="text" name="search" class="form-control" value="<%= search %>">
      </div>
      <div class="col-md-4">
        <label class="form-label">Session (Year Range) / الفترة (سنة البداية – سنة النهاية)</label>
        <input type="text" name="session" class="form-control" placeholder="2019 to 2020" value="<%= session %>">
      </div>
      <div class="col-md-2">
        <button class="btn btn-primary w-100">Filter / تصفية</button>
      </div>
      <div class="col-md-2">
        <button type="button" onclick="window.print()" class="btn btn-secondary w-100">Print / طباعة</button>
      </div>
    </form>

    <!-- CSV Upload -->
    <div class="mb-4 no-print">
      <form id="csvForm" enctype="multipart/form-data">
        <div class="row g-3 align-items-center">
          <div class="col-md-6">
            <input type="file" name="file" accept=".csv" class="form-control" required>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Upload CSV / رفع CSV</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Upcoming vs Active Compare CSV -->
    <div class="mb-4 no-print">
      <form id="compareCsvForm" enctype="multipart/form-data">
        <div class="row g-3 align-items-center">
          <div class="col-md-6">
            <input type="file" name="file" accept=".csv" class="form-control" required>
          </div>
          <div class="col-md-4">
            <small class="text-muted">Compare upcoming with active CSV (by QID). Unmatched -> Delay + other</small>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-warning w-100">Compare CSV</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Export Excel -->
    <button id="exportBtn" class="btn btn-info mb-3 no-print">Export Excel / تصدير Excel</button>

    <!-- Trainee Table -->
    <div class="table-section">
      <table class="table table-bordered table-striped" id="traineeTable">
        <thead class="table-dark">
          <tr>
            <th>QID</th>
            <th>Full Name / الاسم الكامل</th>
            <th>Phone / رقم الهاتف</th>
            <th>Status / الحالة</th>
            <th>Case Type / نوع الحالة</th>
            <th>Reason / السبب</th>
            <th>Batch No / رقم الدفعة</th>
            <th>Batch Start / سنة البداية</th>
            <th>Batch End / سنة النهاية</th>
            <th>Actions / الإجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% if (trainees.length) { %>
            <% trainees.forEach(t => {
                 let statusLabel = '';
                 let statusClass = 'badge-default';
                 let caseClass = 'badge-default';
                 switch(t.status){
                   case 'Completed': statusLabel = 'Completed / مكتمل'; statusClass = 'badge-completed'; break;
                   case 'Active': statusLabel = 'Active / نشط'; statusClass = 'badge-active'; break;
                   case 'Upcoming': statusLabel = 'Upcoming / قادم'; statusClass = 'badge-upcoming'; break;
                   case 'Exception': statusLabel = 'Exception / استثناء'; statusClass = 'badge-exception'; break;
                   case 'Exempted': statusLabel = 'Exempted / معفى'; statusClass = 'badge-exempted'; break;
                   case 'Delay': statusLabel = 'Delay / تأخير'; statusClass = 'badge-delay'; break;
                   case 'Pending': statusLabel = 'Pending / معلق'; statusClass = 'badge-pending'; break;
                   default: statusLabel = t.status;
                 }
                 switch((t.caseType || '').toLowerCase()){
                   case 'completed': caseClass = 'badge-completed'; break;
                   case 'active': caseClass = 'badge-active'; break;
                   case 'upcoming': caseClass = 'badge-upcoming'; break;
                   case 'exception': caseClass = 'badge-exception'; break;
                   case 'exempted': caseClass = 'badge-exempted'; break;
                   case 'delay': caseClass = 'badge-delay'; break;
                 }
            %>
              <tr>
                <td><%= t.qid %></td>
                <td><%= t.fullname %></td>
                <td><%= t.phoneNumber %></td>
                <td><span class="status-badge <%= statusClass %>"><%= statusLabel %></span></td>
                <td><span class="case-badge <%= caseClass %>"><%= t.caseType || '' %></span></td>
                <td><%= t.reason || '' %></td>
                <td><%= t.batchNo || '' %></td>
                <td><%= t.batchStartYear || '' %></td>
                <td><%= t.batchEndYear || '' %></td>
                <td class="no-print">
                  <a href="/training/edit/<%= t._id %>" class="btn btn-warning btn-sm">Edit / تعديل</a>
                  <form action="/training/delete/<%= t._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this trainee? / حذف هذا المتدرب؟');">
                    <button class="btn btn-danger btn-sm">Delete / حذف</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="10" class="text-center">No trainees found / لا يوجد متدربين</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</div>

<script>
  // Export Excel
  document.getElementById('exportBtn').addEventListener('click', () => {
    const table = document.getElementById('traineeTable');
    const wb = XLSX.utils.table_to_book(table, { sheet: "Trainees" });
    XLSX.writeFile(wb, 'trainees.xlsx');
  });

  // CSV Upload
  document.getElementById('csvForm').addEventListener('submit', async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    try {
      const res = await axios.post('/training/upload-csv', formData, { headers: { 'Content-Type': 'multipart/form-data' } });
      if(res.data.success){
        Swal.fire('Success / نجاح', res.data.message, 'success').then(() => location.reload());
      } else {
        Swal.fire('Error / خطأ', res.data.message || 'Upload failed / فشل الرفع', 'error');
      }
    } catch(err) {
      Swal.fire('Error / خطأ', 'Server error / خطأ في الخادم', 'error');
    }
  });

  // Compare upcoming records with active CSV
  document.getElementById('compareCsvForm').addEventListener('submit', async e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    try {
      const res = await axios.post('/training/reconcile-active-csv', formData, {
        headers: { 'Content-Type': 'multipart/form-data' }
      });
      if (res.data.success) {
        Swal.fire('Success / نجاح', res.data.message, 'success').then(() => location.reload());
      } else {
        Swal.fire('Error / خطأ', res.data.message || 'Comparison failed / فشلت المطابقة', 'error');
      }
    } catch (err) {
      Swal.fire('Error / خطأ', 'Server error / خطأ في الخادم', 'error');
    }
  });
</script>

</body>
</html>