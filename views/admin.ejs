<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }
    .sidebar {
      width: 250px;
      min-height: 100vh;
      background-color: #1f2937;
      color: white;
    }
    .sidebar a {
      color: white;
      text-decoration: none;
    }
    .sidebar a:hover {
      background-color: #374151;
    }
    .card {
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      border-radius: 10px;
      text-align: center;
    }
    .card-title {
      font-weight: bold;
    }
  </style>
</head>
<body>

<div class="dashboard-container d-flex">

  <!-- Sidebar -->
  <div class="sidebar p-3">
    <div class="logo mb-4">
      <h3>Admin Panel</h3>
    </div>
    <nav>
      <ul class="nav flex-column">
        <li class="nav-item mb-2">
          <a class="nav-link btn btn-outline-light w-100 mb-2" href="/training/admin">Dashboard</a>
        </li>
        <li class="nav-item mb-2">
          <a class="nav-link btn btn-outline-light w-100" href="/training/add">Add Trainee</a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Main Content -->
  <div class="main-content flex-grow-1 p-4">

    <!-- Header with Logout -->
    <header class="d-flex justify-content-between align-items-center mb-4">
      <h1>Trainee Dashboard</h1>
      <a href="/auth/logout" class="btn btn-danger">Logout</a>
    </header>

    <!-- Total Trainees Card -->
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card text-white bg-primary">
          <div class="card-body">
            <h5 class="card-title">Total Trainees</h5>
            <p class="card-text fs-3"><%= totalTrainees %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter / Search Form -->
    <form id="filterForm" class="row g-3 align-items-center mb-3" method="GET" action="/training/admin">
      <div class="col-md-4 d-flex flex-column">
        <label for="searchInput" class="form-label mb-1">Search (QID / Name / Phone / CaseType)</label>
        <input type="text" id="searchInput" name="search" class="form-control" 
               placeholder="Search by QID, Name, Phone, Case Type" 
               value="<%= search || '' %>">
      </div>
      <div class="col-md-2 d-flex flex-column">
        <label for="batchStartFilter" class="form-label mb-1">From</label>
        <input type="date" id="batchStartFilter" name="from" class="form-control" value="<%= from || '' %>">
      </div>
      <div class="col-md-2 d-flex flex-column">
        <label for="batchEndFilter" class="form-label mb-1">To</label>
        <input type="date" id="batchEndFilter" name="to" class="form-control" value="<%= to || '' %>">
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="printBtn" class="btn btn-success w-100">Print</button>
      </div>
    </form>

    <!-- Trainee Table -->
    <div class="table-section">
      <table class="table table-bordered table-striped" id="traineeTable">
        <thead class="table-dark">
          <tr>
            <th>QID</th>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Case Type</th>
            <th>Batch Start</th>
            <th>Batch End</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% trainees.forEach(trainee => { %>
            <tr>
              <td class="qid"><%= trainee.qid %></td>
              <td class="fullname"><%= trainee.fullname %></td>
              <td class="phone"><%= trainee.phoneNumber %></td>
              <td class="caseType"><%= trainee.caseType %></td>
              <td class="batchStart"><%= trainee.batchStartDate ? trainee.batchStartDate.toISOString().slice(0,10) : '' %></td>
              <td class="batchEnd"><%= trainee.batchEndDate ? trainee.batchEndDate.toISOString().slice(0,10) : '' %></td>
              <td>
                <a href="/training/edit/<%= trainee._id %>" class="btn btn-warning btn-sm">Edit</a>
                <form action="/training/delete/<%= trainee._id %>" method="POST" style="display:inline;" 
                      onsubmit="return confirm('Are you sure you want to delete this trainee?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  const searchInput = document.getElementById('searchInput');
  const batchStartFilter = document.getElementById('batchStartFilter');
  const batchEndFilter = document.getElementById('batchEndFilter');

  // Client-side filter (search + date)
  function filterTable() {
    const searchText = searchInput.value.toLowerCase();
    const startDate = batchStartFilter.value;
    const endDate = batchEndFilter.value;

    const tableRows = document.querySelectorAll('#traineeTable tbody tr');

    tableRows.forEach(row => {
      const qid = row.querySelector('.qid').innerText.toLowerCase();
      const fullname = row.querySelector('.fullname').innerText.toLowerCase();
      const phone = row.querySelector('.phone').innerText.toLowerCase();
      const caseType = row.querySelector('.caseType').innerText.toLowerCase();
      const batchStart = row.querySelector('.batchStart').innerText;
      const batchEnd = row.querySelector('.batchEnd').innerText;

      const matchesSearch =
        qid.includes(searchText) ||
        fullname.includes(searchText) ||
        phone.includes(searchText) ||
        caseType.includes(searchText);

      const matchesStart = !startDate || (batchStart && batchStart >= startDate);
      const matchesEnd = !endDate || (batchEnd && batchEnd <= endDate);

      row.style.display = (matchesSearch && matchesStart && matchesEnd) ? '' : 'none';
    });
  }

  searchInput.addEventListener('input', filterTable);
  batchStartFilter.addEventListener('change', filterTable);
  batchEndFilter.addEventListener('change', filterTable);

  // Print functionality
  document.getElementById('printBtn').addEventListener('click', () => {
    window.print();
  });
</script>

</body>
</html>
