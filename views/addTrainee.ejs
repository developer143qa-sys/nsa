<!DOCTYPE html>
<html lang="<%= locale %>" dir="<%= locale === 'ar' ? 'rtl' : 'ltr' %>">
<head>
<meta charset="UTF-8">
<title><%= __('addTrainee') %></title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
  body { font-family: Arial, sans-serif; }
  body[dir="rtl"] { text-align: right; }
</style>
</head>
<body>

<div class="container mt-3 d-flex justify-content-end">
  <a href="/auth/logout" class="btn btn-danger"><%= __('logout') %></a>
</div>

<div class="container mt-4">
  <h1><%= __('addTrainee') %></h1>

  <!-- Single Trainee Form -->
  <form id="singleForm" class="mb-4">
    <input type="text" name="qid" placeholder="<%= __('qid') %>" class="form-control mb-2" required>
    <input type="text" name="fullname" placeholder="<%= __('fullName') %>" class="form-control mb-2" required>
    <input type="text" name="phoneNumber" placeholder="<%= __('phoneNumber') %>" class="form-control mb-2" required>

    <!-- Case Type -->
    <select name="caseType" id="caseType" class="form-control mb-2" required>
      <option value=""><%= __('selectCaseType') %></option>
      <option value="upcoming"><%= __('upcoming') %></option>
      <option value="completed"><%= __('completed') %></option>
      <option value="delay"><%= __('delay') %></option>
      <option value="exception"><%= __('exception') %></option>
      <option value="exempted"><%= __('exempted') %></option>
    </select>

    <!-- Reason -->
    <select name="reason" id="reason" class="form-control mb-2" style="display:none;">
      <option value=""><%= __('selectReason') %></option>
    </select>

    <!-- Batch No -->
    <div class="mb-2" id="batchNoDiv" style="display:none;">
      <label for="batchNo"><%= __('batchNo') %></label>
      <input type="text" name="batchNo" id="batchNo" class="form-control">
    </div>

    <!-- Force No -->
    <div class="mb-2" id="forceNoDiv" style="display:none;">
      <label for="forceNo"><%= __('forceNo') %></label>
      <input type="text" name="forceNo" id="forceNo" class="form-control">
    </div>

    <!-- Batch Years -->
    <div class="mb-2">
      <label for="batchStartYear"><%= __('batchStartYear') %></label>
      <input type="number" name="batchStartYear" id="batchStartYear" class="form-control" placeholder="e.g. 2025">
      <label for="batchEndYear" class="mt-2"><%= __('batchEndYear') %></label>
      <input type="number" name="batchEndYear" id="batchEndYear" class="form-control" placeholder="e.g. 2026">
    </div>

    <button type="submit" class="btn btn-primary mt-3"><%= __('addTrainee') %></button>
  </form>

  <!-- CSV Upload -->
  <form id="csvForm">
    <h3><%= __('uploadCSV') %></h3>
    <input type="file" name="file" class="form-control mb-2" accept=".csv" required>
    <button class="btn btn-success"><%= __('upload') %></button>
  </form>

  <!-- Language Switch -->
  <div class="text-center mt-3">
    <a href="/lang/en">English</a> | <a href="/lang/ar">العربية</a>
  </div>
</div>

<script>
const caseTypeSelect = document.getElementById('caseType');
const reasonSelect = document.getElementById('reason');
const batchNoDiv = document.getElementById('batchNoDiv');
const forceNoDiv = document.getElementById('forceNoDiv');

const reasonOptions = {
  delay: [
    '<%= __("consideredOnlySon") %>',
    '<%= __("completingStudies") %>',
    '<%= __("onlyChildMother") %>',
    '<%= __("onlyChildFather") %>',
    '<%= __("medicalDeferment") %>',
    '<%= __("studyAbroad") %>',
    '<%= __("soleSupportMother") %>',
    '<%= __("soleSupportDisabledSiblings") %>',
    '<%= __("other") %>'
  ],
  exception: ['<%= __("activeDuty") %>', '<%= __("completedBasic") %>'],
  exempted: ['<%= __("medicallyUnfit") %>']
};

// Show/hide reason, batchNo, forceNo
function applyCaseType(type) {
  let selectedReason = reasonSelect.value;
  reasonSelect.style.display = 'none';
  reasonSelect.innerHTML = `<option value="">${'<%= __("selectReason") %>'}</option>`;
  batchNoDiv.style.display = 'none';
  forceNoDiv.style.display = 'none';

  if(type === 'delay') {
    reasonSelect.style.display = 'block';
    batchNoDiv.style.display = 'block';
    reasonOptions.delay.forEach(r => reasonSelect.innerHTML += `<option value="${r}">${r}</option>`);
  } else if(type === 'completed') {
    batchNoDiv.style.display = 'block';
  } else if(type === 'exception') {
    reasonSelect.style.display = 'block';
    forceNoDiv.style.display = 'block';
    reasonOptions.exception.forEach(r => reasonSelect.innerHTML += `<option value="${r}">${r}</option>`);
  } else if(type === 'exempted') {
    reasonSelect.style.display = 'block';
    reasonOptions.exempted.forEach(r => reasonSelect.innerHTML += `<option value="${r}">${r}</option>`);  
  }

  reasonSelect.value = selectedReason;
}

// Auto-select Upcoming based on batchStartYear
function autoSelectUpcoming() {
  const start = Number(document.getElementById('batchStartYear').value);
  const end = Number(document.getElementById('batchEndYear').value);
  const today = new Date();
  const currentYear = today.getFullYear();

  if(start && start > currentYear){
    caseTypeSelect.value = 'upcoming';
    applyCaseType('upcoming');
  }
}

caseTypeSelect.addEventListener('change', () => applyCaseType(caseTypeSelect.value));
document.getElementById('batchStartYear').addEventListener('input', autoSelectUpcoming);
document.getElementById('batchEndYear').addEventListener('input', autoSelectUpcoming);

// Submit Single Trainee
document.getElementById('singleForm').addEventListener('submit', async e => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target).entries());

  if(!data.caseType){
    Swal.fire('<%= __("error") %>', '<%= __("caseTypeRequired") %>', 'error');
    return;
  }

  try {
    const res = await fetch('/training/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    const result = await res.json();
    Swal.fire({
      title: result.success ? '<%= __("success") %>' : '<%= __("error") %>',
      text: result.message,
      icon: result.success ? 'success' : 'error'
    });
    if(result.success) e.target.reset();
  } catch {
    Swal.fire('<%= __("error") %>', '<%= __("serverError") %>', 'error');
  }
});

// CSV Upload
document.getElementById('csvForm').addEventListener('submit', async e => {
  e.preventDefault();
  const formData = new FormData(e.target);
  try {
    const res = await fetch('/training/upload-csv', { method: 'POST', body: formData });
    const result = await res.json();
    Swal.fire({
      title: result.success ? '<%= __("success") %>' : '<%= __("error") %>',
      text: result.message,
      icon: result.success ? 'success' : 'error'
    });
    if(result.success) e.target.reset();
  } catch {
    Swal.fire('<%= __("error") %>', '<%= __("serverError") %>', 'error');
  }
});

// Initialize
applyCaseType(caseTypeSelect.value);
autoSelectUpcoming();
</script>

</body>
</html>