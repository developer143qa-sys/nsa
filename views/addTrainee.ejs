<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Add Trainee</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
  body { font-family: Arial, sans-serif; }
</style>
</head>
<body>

<div class="container mt-3 d-flex justify-content-end">
  <a href="/auth/logout" class="btn btn-danger">Logout</a>
</div>

<div class="container mt-4">
  <h1>Add Trainee</h1>

  <!-- Single Trainee Form -->
  <form id="singleForm" class="mb-4">
    <input type="text" name="qid" placeholder="QID" class="form-control mb-2" required>
    <input type="text" name="fullname" placeholder="Full Name" class="form-control mb-2" required>
    <input type="text" name="phoneNumber" placeholder="Phone Number" class="form-control mb-2" required>

    <!-- Case Type -->
    <select name="caseType" id="caseType" class="form-control mb-2" required>
      <option value="">Select Case Type</option>
      <option value="completed">Completed</option>
      <option value="delay">Delay</option>
      <option value="exception">Exception</option>
      <option value="exempted">Exempted</option>
    </select>

    <!-- Reason -->
    <select name="reason" id="reason" class="form-control mb-2" style="display:none;">
      <option value="">Select Reason</option>
    </select>

    <!-- Batch No -->
    <div class="mb-2" id="batchNoDiv" style="display:none;">
      <label for="batchNo">Batch No</label>
      <input type="text" name="batchNo" id="batchNo" class="form-control">
    </div>

    <!-- Force No -->
    <div class="mb-2" id="forceNoDiv" style="display:none;">
      <label for="forceNo">Force No</label>
      <input type="text" name="forceNo" id="forceNo" class="form-control">
    </div>

    <!-- Batch Years -->
    <div class="mb-2">
      <label for="batchStartYear">Batch Start Year</label>
      <input type="number" name="batchStartYear" id="batchStartYear" class="form-control" placeholder="e.g. 2025">
      <label for="batchEndYear" class="mt-2">Batch End Year</label>
      <input type="number" name="batchEndYear" id="batchEndYear" class="form-control" placeholder="e.g. 2026">
    </div>

    <!-- Active Checkbox -->
    <div class="form-check mb-2">
      <input type="checkbox" name="isActive" value="true" class="form-check-input" id="isActive">
      <label class="form-check-label" for="isActive">Active</label>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Add Trainee</button>
  </form>

  <!-- CSV Upload -->
  <form id="csvForm">
    <h3>Upload CSV</h3>
    <input type="file" name="file" class="form-control mb-2" accept=".csv" required>
    <button class="btn btn-success">Upload CSV</button>
  </form>
</div>

<script>
const caseTypeSelect = document.getElementById('caseType');
const reasonSelect = document.getElementById('reason');
const batchNoDiv = document.getElementById('batchNoDiv');
const forceNoDiv = document.getElementById('forceNoDiv');
const batchStartYear = document.getElementById('batchStartYear');
const batchEndYear = document.getElementById('batchEndYear');
const isActiveCheckbox = document.getElementById('isActive');

const reasonOptions = {
  delay: [
    'Considered as the only son',
    'Completing studies',
    'Only child of mother',
    'Only child of father',
    'Medical deferment',
    'Accompanying for study abroad',
    'Sole supporter of mother',
    'Sole supporter of disabled siblings',
    'Other'
  ],
  exception: ['Active duty soldier', 'Completed basic training'],
  exempted: ['Medically unfit']
};

// Show/hide reason, batchNo, forceNo
function applyCaseType(type) {
  let selectedReason = reasonSelect.value;
  reasonSelect.style.display = 'none';
  reasonSelect.innerHTML = '<option value="">Select Reason</option>';
  batchNoDiv.style.display = 'none';
  forceNoDiv.style.display = 'none';

  if(type === 'delay') {
    reasonSelect.style.display = 'block';
    batchNoDiv.style.display = 'block';
    reasonOptions.delay.forEach(r => reasonSelect.innerHTML += `<option value="${r}">${r}</option>`);
  } else if(type === 'completed') {
    batchNoDiv.style.display = 'block';
  } else if(type === 'exception') {
    reasonSelect.style.display = 'block';
    forceNoDiv.style.display = 'block';
    reasonOptions.exception.forEach(r => reasonSelect.innerHTML += `<option value="${r}">${r}</option>`);
  } else if(type === 'exempted') {
    reasonSelect.style.display = 'block';
    reasonOptions.exempted.forEach(r => reasonSelect.innerHTML += `<option value="${r}">${r}</option>`);  
  }

  reasonSelect.value = selectedReason;
  updateActiveState();
}

// Enable/disable Active checkbox and Case Type
function updateActiveState() {
  const start = Number(batchStartYear.value);
  const end = Number(batchEndYear.value);
  const currentYear = new Date().getFullYear();

  if(isActiveCheckbox.checked) {
    caseTypeSelect.disabled = true;
    caseTypeSelect.removeAttribute('required');
  } else {
    const enableActive = (!caseTypeSelect.value) && (start === currentYear || end === currentYear);
    isActiveCheckbox.disabled = !enableActive;

    caseTypeSelect.disabled = false;
    caseTypeSelect.setAttribute('required', 'required');
  }
}

// Event listeners
caseTypeSelect.addEventListener('change', () => { applyCaseType(caseTypeSelect.value); updateActiveState(); });
isActiveCheckbox.addEventListener('change', updateActiveState);
batchStartYear.addEventListener('input', updateActiveState);
batchEndYear.addEventListener('input', updateActiveState);

// Submit Single Trainee
document.getElementById('singleForm').addEventListener('submit', async e => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target).entries());
  data.isActive = isActiveCheckbox.checked;

  if(!data.isActive && !data.caseType){
    Swal.fire('Error', 'Case Type is required if trainee is not active', 'error');
    return;
  }

  try {
    const res = await fetch('/training/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    const result = await res.json();
    Swal.fire({
      title: result.success ? 'Success' : 'Error',
      text: result.message,
      icon: result.success ? 'success' : 'error'
    });
    if(result.success) e.target.reset();
    isActiveCheckbox.checked = false;
    updateActiveState();
  } catch {
    Swal.fire('Error', 'Server error', 'error');
  }
});

// CSV Upload
document.getElementById('csvForm').addEventListener('submit', async e => {
  e.preventDefault();
  const formData = new FormData(e.target);
  try {
    const res = await fetch('/training/upload-csv', { method: 'POST', body: formData });
    const result = await res.json();
    Swal.fire({
      title: result.success ? 'Success' : 'Error',
      text: result.message,
      icon: result.success ? 'success' : 'error'
    });
    if(result.success) e.target.reset();
  } catch {
    Swal.fire('Error', 'Server error', 'error');
  }
});

// Initialize
applyCaseType(caseTypeSelect.value);
updateActiveState();
</script>

</body>
</html>
